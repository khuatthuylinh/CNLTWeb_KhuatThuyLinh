@model BookManagement.Models.Book

<h2>Thêm sách</h2>

<form method="post">

    <div>
        <label>Tên sách</label>
        <br />

        <input asp-for="Name" />

        <br />

        <span asp-validation-for="Name"
              style="color:lightcoral"></span>
    </div>

    <br />

    <div>
        <label>Giá</label>
        <br />

        <input asp-for="Price" />

        <br />

        <span asp-validation-for="Price"
              style="color:lightcoral"></span>
    </div>

    <br />

    <button type="submit">
        Thêm
    </button>

</form>

<br />

<h3 style="color:green">
    @ViewBag.Message
</h3>