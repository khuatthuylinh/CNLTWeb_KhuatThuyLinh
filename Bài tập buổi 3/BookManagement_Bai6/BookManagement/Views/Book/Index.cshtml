@model List<BookManagement.Models.Book>

<h2>Danh sách sách</h2>

<table border="1" cellpadding="10">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Price</th>
        <th>Action</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.Price</td>
            <td>
                <a href="/Book/Detail/@item.Id">Chi tiết</a>
            </td>
        </tr>
    }
</table>

<br />

<a href="/Book/Create">Thêm sách</a>