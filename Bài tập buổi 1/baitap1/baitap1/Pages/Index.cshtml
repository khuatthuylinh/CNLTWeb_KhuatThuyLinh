                <img src="~/images/2.webp" alt="Giải phóng mặt bằng" />
            </div>
        </div>

        <div class="col-md-4 border-end px-3">
            <h5 class="fw-bold mb-2" style="font-size: 16px; line-height: 1.4; min-height: 44px;">
                <a href="#" class="text-decoration-none text-dark">TP HCM siết kiểm soát người nhập cảnh phòng Ebola</a>
