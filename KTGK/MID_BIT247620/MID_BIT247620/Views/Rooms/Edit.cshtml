@model MID_BIT247620.Models.Room_BIT247620

@{
    ViewData["Title"] = "Chỉnh sửa Phòng trọ";
}

<div class="container mt-3">
    <h2>Chỉnh sửa phòng trọ</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Edit" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />

                <div class="form-group mb-3">
                    <label asp-for="Name" class="control-label fw-bold"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="RoomTypeId" class="control-label fw-bold"></label>
                    <select asp-for="RoomTypeId" class="form-select" asp-items="ViewBag.RoomTypeId"></select>
                    <span asp-validation-for="RoomTypeId" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Price" class="control-label fw-bold"></label>
                    <input asp-for="Price" class="form-control" type="number" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Area" class="control-label fw-bold"></label>
                    <input asp-for="Area" class="form-control" type="number" step="any" />
                    <span asp-validation-for="Area" class="text-danger"></span>
                </div>

                <div class="form-group mb-3 form-check">
                    <input class="form-check-input" type="checkbox" asp-for="IsAvailable">
                    <label class="form-check-label" asp-for="IsAvailable">Còn phòng trống</label>
                </div>

                @{
                    var thumbnail = Model.RoomImages?.FirstOrDefault(i => i.IsThumbnail);
                    var thumbnailUrl = thumbnail?.ImageUrl;
                }
                @if (!string.IsNullOrEmpty(thumbnailUrl))
                {
                    <div class="mb-3">
                        <label class="control-label fw-bold d-block">Ảnh đại diện hiện tại</label>
                        <img src="@thumbnailUrl" alt="current thumbnail" style="width: 150px; height: 100px; object-fit: cover;" onerror="this.onerror=null;this.src='https://placehold.co/150x100?text=Loi+anh';" />
                        <span class="text-muted d-block small">@thumbnailUrl</span>
                    </div>
                }

                <div class="form-group mb-3">
                    <label class="control-label fw-bold">Đổi đường dẫn ảnh đại diện (URL)</label>
                    <input type="url" name="imageUrl" class="form-control" value="@thumbnailUrl" placeholder="Nhập liên kết ảnh mới..." />
                </div>

                <div class="form-group mb-3">
                    <label class="control-label fw-bold">Hoặc Tải ảnh đại diện mới lên</label>
                    <input type="file" name="imageFile" class="form-control" accept="image/*" />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Description" class="control-label fw-bold"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-warning">Lưu lại</button>
                    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
