@model EmployeeManagement.Models.Employee

@{
    ViewData["Title"] = "Chi tiết nhân viên";
}

<div class="card my-4">
    <div class="card-header bg-info text-white"><h3>Hồ sơ: @Model.FullName</h3></div>
    <div class="card-body">
        <p><strong>Mã số:</strong> @Model.Id</p>
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Phòng ban:</strong> @Model.Department</p>
        <p><strong>Mức lương:</strong> @string.Format("{0:N0} đ", Model.BaseSalary)</p>
        <p><strong>Trạng thái:</strong> @Model.Status</p>
    </div>
    <div class="card-footer">
        <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
    </div>
</div>